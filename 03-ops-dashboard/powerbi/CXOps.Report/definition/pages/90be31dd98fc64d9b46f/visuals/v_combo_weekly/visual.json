{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "v_combo_weekly",
  "position": {
    "x": 20,
    "y": 180,
    "z": 160,
    "width": 1180,
    "height": 470,
    "tabOrder": 160
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "week_start_date"
                }
              },
              "queryRef": "dim_date.week_start_date",
              "nativeQueryRef": "week_start_date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Contacts"
                }
              },
              "queryRef": "_Measures.Contacts",
              "nativeQueryRef": "Contacts"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "SLA %"
                }
              },
              "queryRef": "_Measures.SLA %",
              "nativeQueryRef": "SLA %"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Contacts (column) vs SLA attainment (line) by week'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12"
                }
              }
            }
          }
        }
      ]
    }
  }
}